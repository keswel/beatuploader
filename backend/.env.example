# ─── Beatuploader backend environment ─────────────────────────────────────────
# Copy to backend/.env and fill in real values before deploying.
# In DEBUG=false (prod), weak/missing secrets will REFUSE to boot.

# ─── Core ─────────────────────────────────────────────────────────────────────

# false in prod. Enables HSTS, refuses dev-default secrets, hides verbose errors.
DEBUG=false

# Postgres URL for prod (SQLite is fine only for dev).
# Format: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/beatuploader

# Public URL where the FastAPI app is reachable. Used to compute OAuth redirect
# URIs — must match what's registered in Google Console EXACTLY (no trailing slash).
BACKEND_BASE_URL=https://api.yourapp.com

# Public URL where the React frontend is served. Used for OAuth callback redirects.
# NOTE: must be spelled FRONTEND_BASE_URL — Pydantic silently ignores unknown keys.
FRONTEND_BASE_URL=https://yourapp.com

# Comma-separated allowed origins for CORS. MUST be set explicitly in prod.
# Never use "*" because allow_credentials is True.
CORS_ORIGINS=https://yourapp.com

# ─── Secrets (REQUIRED in prod) ───────────────────────────────────────────────

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_ME_WITH_A_VALID_FERNET_KEY

# Optional overrides for JWT behavior. Defaults are fine.
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Google / YouTube OAuth ───────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials.
# Same client serves both Google sign-in and YouTube uploads.
YOUTUBE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-YOUR_SECRET

# ─── Email (password reset, future verification) ──────────────────────────────
# If SMTP_HOST is empty, emails are LOGGED to stdout instead of sent — fine for
# dev. Set all four in prod (use any SMTP-relay provider: Resend, Postmark,
# Mailgun, SES, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address that appears in sent emails.
SMTP_FROM=Beatuploader <noreply@yourapp.com>

# ─── Error tracking (optional but recommended) ────────────────────────────────
# sentry.io → create a Python/FastAPI project → paste the DSN here.
# If unset, Sentry stays silent — the app still runs.
SENTRY_DSN=

# Tag events with the environment so prod errors don't drown in dev noise.
SENTRY_ENVIRONMENT=production

# ─── Storage ──────────────────────────────────────────────────────────────────
# Where uploaded audio + artwork + BeatStars diagnostics live.
# Mount a persistent volume here in prod; the local filesystem on most PaaS
# hosts is ephemeral and wiped on redeploy.
STORAGE_DIR=/app/storage

# ─── Other ────────────────────────────────────────────────────────────────────

# How long an OAuth "state" JWT is valid between authorize → callback.
OAUTH_STATE_EXPIRE_SECONDS=600

# How long a password-reset link is valid after the user requests it.
PASSWORD_RESET_EXPIRE_SECONDS=1800
