# `DEBUG=true` relaxes secret-strength checks and surfaces more error detail.
# MUST be `false` in production. Default is true for local dev convenience.
DEBUG=true

# Database — use sqlite+aiosqlite for dev, postgresql+asyncpg for prod
DATABASE_URL=sqlite+aiosqlite:///./beatuploader.db

# JWT secret — REQUIRED (>= 32 chars) in prod.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-prod-this-is-not-secure-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# CORS — frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where this backend is reachable from the user's browser (used for OAuth redirect URIs)
BACKEND_BASE_URL=http://localhost:8000
# Where to send the user after OAuth completes
FRONTEND_BASE_URL=http://localhost:5173

# Fernet key for encrypting platform tokens (OAuth + headless passwords) at rest.
# REQUIRED in prod. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=generate-with-Fernet.generate_key

# Platform OAuth credentials (filled in when you wire each platform)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
