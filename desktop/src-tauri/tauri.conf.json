{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beatuploader",
  "version": "0.1.1",
  "identifier": "app.beatuploader.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beatuploader",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Beatuploader",
    "shortDescription": "Upload beats to BeatStars and YouTube in one go",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGREUwRDA4MDVFMjZFNkIKUldScmJ1SUZDQTNlVDJ6M0tXMUlWNVlqOVZjVjJVaFBFWjVINzVjVHRDT0VseTE4NDZHaGU4b08K",
      "endpoints": [
        "https://github.com/keswel/beatuploader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
