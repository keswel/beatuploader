# Frontend env template. For local dev, copy to `frontend/.env.local`.
# For Vercel, set these in the Project Settings → Environment Variables UI.
#
# Vite exposes only env vars prefixed with VITE_ to the client bundle.

# Where to send /api/* requests. In prod this should be your backend's public
# URL (with the /api suffix). In dev, leave it pointed at localhost:8001 (the
# port start-backend.ps1 uses).
VITE_API_BASE=http://127.0.0.1:8001/api

# Example production value:
# VITE_API_BASE=https://api.beatuploader.com/api
